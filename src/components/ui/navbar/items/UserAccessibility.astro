---
import { Icon } from "astro-icon/components";
---

<style>
  @keyframes languageMenuIn {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes languageMenuOut {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-10px) scale(0.95);
    }
  }

  #language-menu {
    animation-duration: 0.2s;
    animation-fill-mode: forwards;
    pointer-events: none;
    opacity: 0;
  }

  #language-menu.visible {
    pointer-events: auto;
    animation-name: languageMenuIn;
  }

  #language-menu.closing {
    animation-name: languageMenuOut;
  }
</style>

<div class="relative md:hidden">
  <button
    class="flex justify-center items-center p-2 bg-primary/10 rounded-md cursor-pointer hover:bg-primary/20 transition-colors"
  >
    <Icon
      name="material-symbols:app-registration-outline"
      class="size-4 text-primary"
    />
  </button>
</div>

<ul class="flex items-center gap-2 max-md:hidden">
  <li>
    <button
      id="toggle-theme"
      title="Alternar tema"
      aria-label="Alternar tema"
      class="flex justify-center items-center p-2 bg-primary/10 rounded-md cursor-pointer hover:bg-primary/20 transition-colors"
      type="button"
    >
      <Icon
        id="light-icon"
        name="material-symbols:light-mode-rounded"
        class="size-4 text-primary"
      />
      <Icon
        id="dark-icon"
        name="material-symbols:dark-mode-rounded"
        class="hidden size-4 text-primary"
      />
    </button>
  </li>
  <li class="relative">
    <button
      id="language-button-menu"
      title="Cambiar idioma"
      aria-label="Cambiar idioma"
      class="flex justify-center items-center p-2 bg-primary/10 rounded-md cursor-pointer hover:bg-primary/20 transition-colors"
      type="button"
    >
      <Icon
        name="material-symbols:translate-rounded"
        class="size-4 text-primary"
      />
    </button>

    <ul
      id="language-menu"
      class="absolute top-full backdrop-blur-xs bg-white/40 dark:bg-black/60 dark:text-white rounded-md [&_li_button]:size-full [&_li]:rounded-[inherit] [&_li_button]:rounded-[inherit] [&_li_button]:p-2 [&_li_button]:cursor-pointer [&_li_button]:text-sm [&_li_button]:flex [&_li_button]:items-center [&_li_button]:gap-2"
    >
      <li>
        <button
          data-btn="language-button"
          class="hover:bg-primary/20 hover:text-primary hover:border hover:border-primary"
        >
          <Icon name="circle-flags:lang-es-mx" class="size-6" />
          <span>Español</span>
        </button>
      </li>
      <li>
        <button
          data-btn="language-button"
          class="hover:bg-primary/20 hover:text-primary hover:border hover:border-primary"
        >
          <Icon name="circle-flags:lang-en-us" class="size-6" />
          <span>Inglés</span>
        </button>
      </li>
      <li>
        <button
          data-btn="language-button"
          class="hover:bg-primary/20 hover:text-primary hover:border hover:border-primary"
        >
          <Icon name="circle-flags:lang-pt-br" class="size-6" />
          <span>Portugués</span>
        </button>
      </li>
    </ul>
  </li>
</ul>

<script>
  const root = document.documentElement;
  // Elementos para alternar el tema
  const $toggleThemeBtn = document.getElementById("toggle-theme");
  const $lightThemeIcon = document.getElementById("light-icon");
  const $darkThemeIcon = document.getElementById("dark-icon");
  // Elementos para cambiar el idioma
  const $languageMenu = document.getElementById("language-menu");
  const $languageBtn = document.getElementById("language-button-menu");

  const savedTheme = localStorage.getItem("theme");
  if (savedTheme === "dark") {
    $lightThemeIcon?.classList.add("hidden");
    $darkThemeIcon?.classList.remove("hidden");
  }

  // Alternar el tema de la aplicación
  $toggleThemeBtn?.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");

    if (isDark) {
      $lightThemeIcon?.classList.add("hidden");
      $darkThemeIcon?.classList.remove("hidden");
    } else {
      $lightThemeIcon?.classList.remove("hidden");
      $darkThemeIcon?.classList.add("hidden");
    }
  });

  // Alternar menú de idiomas
  $languageBtn?.addEventListener("click", () => {
    if (!$languageMenu) return;

    const isOpen = $languageMenu.classList.contains("visible");

    if (isOpen) {
      closeLanguageMenu();
    } else {
      openLanguageMenu();
    }
  });

  // Cerrar menú al hacer click afuera
  root.addEventListener("click", (e) => {
    if (!$languageMenu || !$languageBtn) return;

    const target = e.target;
    if (!(target instanceof Node)) return;

    const isClickInside =
      $languageMenu.contains(target) || $languageBtn.contains(target);

    if (!isClickInside && $languageMenu.classList.contains("visible"))
      closeLanguageMenu();
  });

  function openLanguageMenu() {
    if (!$languageMenu) return;

    $languageMenu.classList.remove("closing");
    $languageMenu.classList.add("visible");
  }

  function closeLanguageMenu() {
    if (!$languageMenu) return;

    // Si ya está cerrándose, evita re-disparar
    if ($languageMenu.classList.contains("closing")) return;

    $languageMenu.classList.remove("visible");
    $languageMenu.classList.add("closing");

    $languageMenu.addEventListener(
      "animationend",
      () => {
        $languageMenu.classList.remove("closing");
      },
      { once: true }
    );
  }

  // Cerrar menú al seleccionar un idioma
  $languageMenu?.addEventListener("click", (e: MouseEvent) => {
    const path = e.composedPath();
    const button = path.find(
      (el): el is HTMLButtonElement =>
        el instanceof HTMLButtonElement && el.dataset.btn === "language-button"
    );

    if (!button) return;

    const lang = button.querySelector("span")?.textContent?.trim();
    if (lang) {
      // Gestionar la lógica para cambiar el idioma
      console.log(`Idioma seleccionado: ${lang}`);
      closeLanguageMenu();
    }
  });
</script>
