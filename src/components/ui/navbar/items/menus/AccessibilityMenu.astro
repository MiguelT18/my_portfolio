<style>
  @keyframes accessibilityMenuIn {
    from {
      opacity: 0;
      transform: translateX(-200px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes accessibilityMenuOut {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-200px);
    }
  }

  #accessibility-menu {
    animation-duration: 0.3s;
    animation-fill-mode: forwards;
    pointer-events: none;
    opacity: 0;
  }

  #accessibility-menu.visible {
    pointer-events: auto;
    animation-name: accessibilityMenuIn;
  }

  #accessibility-menu.closing {
    animation-name: accessibilityMenuOut;
  }
</style>

<aside
  id="accessibility-menu"
  class="md:hidden fixed z-10 w-1/2 size-dvh max-w-[280px] bg-white/80 dark:bg-black/80 backdrop-blur-sm"
>
  <div class="size-full flex flex-col items-center justify-center gap-2">
    <h1 class="text-md font-medium text-center">Menú de accesibilidad</h1>

    <button
      id="close-accessibility-button"
      class="p-2 rounded-md text-sm border border-primary text-primary active:bg-primary/25 transition-colors"
    >
      Cerrar
    </button>
  </div>
</aside>

<script>
  document.addEventListener("astro:page-load", () => {
    function openAccessibilityMenu() {
      if (!$accesibilityMenu) return;
      $accesibilityMenu?.classList.remove("closing");
      $accesibilityMenu?.classList.add("visible");
    }

    function closeAccessibilityMenu() {
      $accesibilityMenu?.classList.remove("visible");
      $accesibilityMenu?.classList.add("closing");

      $accesibilityMenu?.addEventListener(
        "animationend",
        () => {
          $accesibilityMenu.classList.remove("closing");
        },
        { once: true }
      );
    }

    const root = document.documentElement;
    const $accesibilityMenu = document.getElementById("accessibility-menu");
    const $closeAccessibilityMenuBtn = document.getElementById(
      "close-accessibility-button"
    );
    const $openAccessibilityMenuBtn = document.getElementById(
      "accessibility-open-menu-button"
    );

    $openAccessibilityMenuBtn?.addEventListener("click", () => {
      openAccessibilityMenu();
    });

    $closeAccessibilityMenuBtn?.addEventListener("click", () => {
      closeAccessibilityMenu();
    });

    root.addEventListener("click", (e) => {
      if (!$accesibilityMenu || !$openAccessibilityMenuBtn) return;

      const target = e.target;
      if (!(target instanceof Node)) return;

      const isClickInside =
        $accesibilityMenu.contains(target) ||
        $openAccessibilityMenuBtn.contains(target);

      if (!isClickInside && $accesibilityMenu.classList.contains("visible"))
        closeAccessibilityMenu();
    });
  });
</script>
