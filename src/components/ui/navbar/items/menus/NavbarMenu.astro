<style>
  @keyframes NavbarMenuIn {
    from {
      opacity: 0;
      transform: translateX(200px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes NavbarMenuOut {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(200px);
    }
  }

  #navbar-menu {
    animation-duration: 0.3s;
    animation-fill-mode: forwards;
    pointer-events: none;
    opacity: 0;
  }

  #navbar-menu.visible {
    pointer-events: auto;
    animation-name: NavbarMenuIn;
  }

  #navbar-menu.closing {
    animation-name: NavbarMenuOut;
  }
</style>

<aside
  id="navbar-menu"
  class="md:hidden fixed right-0 z-10 w-1/2 size-dvh max-w-[280px] bg-white/80 dark:bg-black/80 backdrop-blur-sm"
>
  <div class="size-full flex flex-col items-center justify-center gap-2">
    <h1 class="text-md font-medium text-center">Menú de navegación</h1>

    <button
      id="close-navbar-button"
      class="p-2 rounded-md text-sm border border-primary text-primary active:bg-primary/25 transition-colors"
    >
      Cerrar
    </button>
  </div>
</aside>

<script>
  document.addEventListener("astro:page-load", () => {
    function openNavbarMenu() {
      if (!$navbarMenu) return;
      $navbarMenu?.classList.remove("closing");
      $navbarMenu?.classList.add("visible");
    }

    function closeNavbarMenu() {
      $navbarMenu?.classList.remove("visible");
      $navbarMenu?.classList.add("closing");

      $navbarMenu?.addEventListener(
        "animationend",
        () => {
          $navbarMenu.classList.remove("closing");
        },
        { once: true }
      );
    }

    const root = document.documentElement;
    const $navbarMenu = document.getElementById("navbar-menu");
    const $closeNavbarMenuBtn = document.getElementById("close-navbar-button");
    const $openNavbarMenuBtn = document.getElementById(
      "navbar-open-menu-button"
    );

    $openNavbarMenuBtn?.addEventListener("click", () => {
      openNavbarMenu();
    });

    $closeNavbarMenuBtn?.addEventListener("click", () => {
      closeNavbarMenu();
    });

    root.addEventListener("click", (e) => {
      if (!$navbarMenu || !$openNavbarMenuBtn) return;

      const target = e.target;
      if (!(target instanceof Node)) return;

      const isClickInside =
        $navbarMenu.contains(target) || $openNavbarMenuBtn.contains(target);

      if (!isClickInside && $navbarMenu.classList.contains("visible"))
        closeNavbarMenu();
    });
  });
</script>
